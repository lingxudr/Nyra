<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_elev"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/editor_dialog_title"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/console_bg"
        android:padding="10dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/dropzone_bg"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="3"
        android:maxLines="8"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:hint="@string/editor_dialog_hint"
        android:textSize="14sp"
        android:importantForAutofill="no" />
</LinearLayout>
