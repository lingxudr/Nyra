    <color name="bg">#0F1117</color>
    <color name="bg_elev">#161927</color>
    <color name="card">#1B1F30</color>
    <color name="card_soft">#222739</color>
    <color name="widget">#12141D</color>
    <color name="border">#2C3145</color>
    <color name="border_focus">#4A5170</color>

    <!-- Aksen utama merek: ungu #7B61FF, dengan ungu terang dan biru langit
         sebagai warna pendamping pada gradien logo. -->
    <color name="accent">#7B61FF</color>
    <color name="accent_dark">#5B44D6</color>
    <color name="accent_soft">#337B61FF</color>
